extends ../../layouts/default.pug

block main
  h1(class="mb-4") Phân quyền

  // Nút tạo nhóm quyền
  div(class="text-right mb-3")
    button(
      type='submit'
      button-submit
      class="btn btn-primary"
    ) Cập nhật
  div(data-records=records)

  table(class="table table-hover table-sm" table-permissions)
    thead
      tr
        th Tính năng
        each item in records 
          th(class="text-center") #{item.title}

    tbody
      tr(data-name="id")
        td ID
        each item in records
          td
            input(type="hidden" value=item._id)
      tr
        td(colspan="3")
          b Danh sách sản phẩm    
      tr(data-name="products-view")
        td Xem sản phẩm
        each item in records
          td(class="text-center")
            input(type="checkbox")
      tr(data-name="products-create")
        td Thêm mới
        each item in records
          td(class="text-center")
            input(type="checkbox")

      tr(data-name="products-edit")
        td Chỉnh sửa
        each item in records
          td(class="text-center")
            input(type="checkbox")

      tr(data-name="products-delete")
        td Xóa
        each item in records
          td(class="text-center")
            input(type="checkbox")
      tr
        td(colspan="3")
          b Danh mục sản phẩm    
      tr(data-name="product-category-view")
        td Xem danh mục
        each item in records
          td(class="text-center")
            input(type="checkbox")
      tr(data-name="products-category-create")
        td Thêm mới
        each item in records
          td(class="text-center")
            input(type="checkbox")

      tr(data-name="products-category-edit")
        td Chỉnh sửa
        each item in records
          td(class="text-center")
            input(type="checkbox")

      tr(data-name="products-category-delete")
        td Xóa
        each item in records
          td(class="text-center")
            input(type="checkbox")
      tr
        td(colspan="3")
          b Nhóm quyền 
      tr(data-name="roles-view")
        td Xem nhóm quyền
        each item in records
          td(class="text-center")
            input(type="checkbox")
      tr(data-name="roles-create")
        td Thêm mới
        each item in records
          td(class="text-center")
            input(type="checkbox")

      tr(data-name="roles-edit")
        td Chỉnh sửa
        each item in records
          td(class="text-center")
            input(type="checkbox")

      tr(data-name="roles-delete")
        td Xóa
        each item in records
          td(class="text-center")
            input(type="checkbox")
      tr
        td(colspan="3")
          b Phân quyền 
      tr(data-name="permissions-view")
        td Xem phân quyền
        each item in records
          td(class="text-center")
            input(type="checkbox")
      tr(data-name="permissions-create")
        td Thêm mới
        each item in records
          td(class="text-center")
            input(type="checkbox")

      tr(data-name="permissions-edit")
        td Chỉnh sửa
        each item in records
          td(class="text-center")
            input(type="checkbox")

      tr(data-name="permissions-delete")
        td Xóa
        each item in records
          td(class="text-center")
            input(type="checkbox")
      tr
        td(colspan="3")
          b Danh sách tài khoản 
      tr(data-name="accounts-view")
        td Xem tài khoản
        each item in records
          td(class="text-center")
            input(type="checkbox")
      tr(data-name="accounts-create")
        td Thêm mới
        each item in records
          td(class="text-center")
            input(type="checkbox")

      tr(data-name="accounts-edit")
        td Chỉnh sửa
        each item in records
          td(class="text-center")
            input(type="checkbox")

      tr(data-name="accounts-delete")
        td Xóa
        each item in records
          td(class="text-center")
            input(type="checkbox")
  

  form(
    action = '/admin/roles/permissions?_method=PATCH'
    method = 'POST'
    id='form-submit-permissions'
  )
    div(class='form-group')
      input(
      type='text'
      class='form-control d-none'
      name='permissions'
      )

  script(src="/admin/js/permissions.js") 
