extends ../../layouts/default.pug
include ../../mixins/filter-status
include ../../mixins/paging
include ../../mixins/form-change-multi
include ../../mixins/sort
include ../../mixins/categoryTable

block main

  +alert('success', messages.success)
  +alert('danger', messages.danger)
  +alert('warning', messages.warning)
  +alert('info', messages.info)
    
  h1 Trang Products Category Admin


  .card.mb-3
    .card-header Bộ lọc và Tìm kiếm
    .card-body
      .row
        .col-6 
          
        .col-6 
          form(id="form-search")
            .input-group
              input(
                  type="text"
                  placeholder="Nhập từ khóa"
                  name="keyword"
                  class="form-control"
                  value= keyword
              )
              .input-group-append
                button(
                    class="btn btn-success"
                    type="submit"
                ) Tìm    


  .card.mb-3
  .card-header Sắp xếp
  .card-body
    .row
      .col-4
        +sort()
    

  .card.mb-3
    .card-header Danh sách sản phẩm
    .card-body
      .row 
        .col-8 
          +form-change-multi(`/admin/products/change-multi?_method=PATCH`)
        .col-4 
          a(
            href=`/admin/products-category/create`
            class="btn btn-outline-success"
          ) + Add Product

      table(
        class = 'table table-hover table-sm'
        checkbox-multi)
        thead
          tr
              th 
                input(type = 'checkbox' name='checkall')
              th STT
              th Hình ảnh
              th Tiêu đề
              
              th Vị trí
              th Trạng thái
              th Hành động
        tbody
        +categoryTable(records, 1)


  
  form(
    action = ''
    method = 'POST'
    id='form-change-status'
    path='/admin/products/change-status'
  )
  form(
    action = ''
    method = 'POST'
    id='form-delete'
    path='/admin/products/delete'
  )

  script(src="/admin/js/product-change-status.js") 

      
                  

        


