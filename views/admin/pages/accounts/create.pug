extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  h1(class="mb-4") Thêm mới tài khoản
  +alert('success', messages.success)
  +alert('danger', messages.danger)
  +alert('warning', messages.warning)
  +alert('info', messages.info)

  form(
    action=`/admin/accounts/create`
    method="POST"
    enctype="multipart/form-data"
  )
    div(class="form-group")
      label(for="fullName") Họ tên *
      input(
        type="text"
        class="form-control"
        id="fullName"
        name="fullName"
        required
      )
    div(class="form-group")
      label(for="email") Email *
      input(
        type="email"
        class="form-control"
        id="email"
        name="email"
        required
      )

    div(class="form-group")
      label(for="password") Mật khẩu *
      input(
        type="password"
        class="form-control"
        id="password"
        name="password"
        required
      )
    div(class="form-group")
      label(for="phone") Số điện thoại
      input(
        type="text"
        class="form-control"
        id="phone"
        name="phone"
      )
    div(
      class="form-group"
      upload-image
    )
      label(for="avatar") Avatar
      input(
        type="file"
        class="form-control-file"
        id="avatar"
        name="avatar"
        accept="image/*"
        upload-image-input
      )
      img(
        src=""
        class="image-preview"
        upload-image-preview
      )
    div(class="form-group")
      label(for="roleId") Phân quyền
      select(name="roleId" id="roleId" class="form-control")
        option(disabled) -- Chọn --
        each item in records 
          option(value=item._id) #{item.title}
    div(class="form-group form-check form-check-inline")
      input(
        type="radio"
        class="form-check-input"
        id="statusActive"
        name="status"
        value="active"
        checked
      )
      label(for="statusActive" class="form-check-label") Hoạt động
    div(class="form-group form-check form-check-inline")
      input(
        type="radio"
        class="form-check-input"
        id="statusInactive"
        name="status"
        value="inactive"
        checked
      )
      label(for="statusInactive" class="form-check-label") Dừng hoạt động
    div(class="form-group")
      button(
        type="submit"
        class='btn btn-primary'
      )  Tạo mới


