extends ../../layouts/default.pug

block main
  h1(class="mb-4") Phân quyền

  // Nút tạo nhóm quyền
  div(class="text-right mb-3")
    button(
      type='submit'
      button-submit
      class="btn btn-primary"
    ) Cập nhật

  table(class="table table-hover table-sm" table-permissions)
    thead
      tr
        th Tính năng
        each item in records 
          th(class="text-center") #{item.title}

    tbody
      tr(data-name="id")
        td
        each item in records
          td(class="text-center")
            input(type="text" value=item._id)
      tr
        td(colspan="3")
          b Danh mục sản phẩm    
      tr(data-name="product-category-view")
        td Xem danh mục
        each item in records
          td(class="text-center")
            input(type="checkbox")
      tr(data-name="products-category-view")
        td Xem
        each item in records
          td(class="text-center")
            input(type="checkbox")

      tr(data-name="products-category-create")
        td Thêm mới
        each item in records
          td(class="text-center")
            input(type="checkbox")

      tr(data-name="products-category-edit")
        td Chỉnh sửa
        each item in records
          td(class="text-center")
            input(type="checkbox")

      tr(data-name="products-category-delete")
        td Xóa
        each item in records
          td(class="text-center")
            input(type="checkbox")
  

  form(
    action = '/admin/roles/permissions?_method=PATCH'
    method = 'POST'
    id='form-submit-permissions'
  )
    div(class='form-group')
      input(
      type='text'
      class='form-control'
      name='permissions'
      )

  script(src="/admin/js/permissions.js") 
