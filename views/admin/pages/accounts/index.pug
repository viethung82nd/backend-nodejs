extends ../../layouts/default.pug
include ../../mixins/filter-status
include ../../mixins/paging
include ../../mixins/form-change-multi
include ../../mixins/sort
include ../../mixins/categoryTable
include ../../mixins/alert

block main

  +alert('success', messages.success)
  +alert('danger', messages.danger)
  +alert('warning', messages.warning)
  +alert('info', messages.info)
    
  h1 Trang Accounts
    

  .card.mb-3
    .card-header Danh sách tài khoản
    .card-body
      .row 
        .col-8 
          +form-change-multi(`/admin/products/change-multi?_method=PATCH`)
        .col-4 
          a(
            href=`/admin/accounts/create`
            class="btn btn-outline-success"
          ) + Thêm tài khoản

      table(
        class = 'table table-hover table-sm'
        checkbox-multi)
        thead
          tr
              th 
                input(type = 'checkbox' name='checkall')
              th STT
              th Hình ảnh
              th Tên
              th Email
              th Phân quyền
              th Trạng thái
              th Hành động
        tbody
        each item, index in accounts
          tr
              td 
                 input(type="checkbox" name='id' value=item.id)
              td #{index + 1}
              td
                  img(
                      src= item.avatar
                      alt= item.fullName
                      width="100px"
                      height="auto"
                  )
              td #{item.fullName}
              td #{item.email}
              td #{item.role.title}
              td
                  if(item.status == "active")
                      a(href="javascript:;"
                       class="badge badge-success"
                       button-change-status 
                       data-status= 'active'
                       data-id= item.id
                       ) Hoạt động
                  else 
                      a(href="javascript:;" 
                      class="badge badge-danger"
                      button-change-status 
                      data-status= 'inactive'
                      data-id= item.id
                      ) Dừng hoạt động
              td
                  a(href=`/admin/products/detail/${item._id}` class="btn btn-info btn-sm mr-1") Chi tiết
                  a(href=`/admin/products/edit/${item._id}` class="btn btn-warning btn-sm") Sửa
                  button(class="btn btn-danger btn-sm ml-1" button-delete delete-id= item.id) Xóa
        


      
                  

        


